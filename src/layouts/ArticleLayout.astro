
---
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | FFヒーター設置と自動化</title>
  </head>
  <body>
    <header>
      <a href="/">軽自動車へのFFヒーター設置と自動化</a>
    </header>

    <main>
      <article>
        <slot />
      </article>
      <p class="back"><a href="/">← トップページに戻る</a></p>
    </main>

    <footer>FFヒーター設置と自動化の記録</footer>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 850px;
    margin: auto;
    padding: 24px;
    color: #263238;
    line-height: 1.9;
  }

  header {
    padding: 20px;
    background: #edf5f7;
    border-radius: 12px;
    font-weight: bold;
  }

  a { color: #176b88; }

  article { margin-top: 36px; }

  article img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .back { margin-top: 48px; }

  footer {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid #ddd;
    color: #777;
  }
</style>
